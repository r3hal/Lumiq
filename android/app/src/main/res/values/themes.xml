<resources>
    <style name="Theme.Lumiq" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/lumiq_ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Launch screen: the Lumiq mark centered on Ink, same as iPhone. -->
    <style name="Theme.Lumiq.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/lumiq_ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Lumiq</item>
    </style>
</resources>
