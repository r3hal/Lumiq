# Public HTTPS DNS name pointing at the always-on backend, not the home PC.
BACKUP_DOMAIN=backup.example.com
PUBLIC_BASE_URL=https://backup.example.com
FOCAL_DATA=/data
OWNER_LABEL=Owner photo backup
# Generate fresh values on the backend host. Never put this .env in an IPA or Git.
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_A_FRESH_FERNET_KEY
ADMIN_TOKEN=REPLACE_WITH_A_FRESH_RANDOM_32_BYTE_OR_LONGER_TOKEN
# OAuth client type: Web application. Only the owner authorizes this client.
GOOGLE_CLIENT_ID=REPLACE_WITH_WEB_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE_ON_BACKEND_ONLY
# Same Google Cloud project as OAuth. Key restricted to Picker API and owner web origin.
GOOGLE_PICKER_API_KEY=REPLACE_WITH_RESTRICTED_BROWSER_PICKER_KEY
GOOGLE_PROJECT_NUMBER=REPLACE_WITH_NUMERIC_GOOGLE_CLOUD_PROJECT_NUMBER
# Destination is fixed in server code, NOT an arbitrary client-provided folder.
# 1z7BpcVwsZAJ5ruPRHKbJ6VbnsQbOhrkU
STORAGE_BYTES_LIMIT=5368709120
DEVICE_DAILY_BYTES_LIMIT=2147483648
